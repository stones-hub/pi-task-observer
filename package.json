{
  "name": "pi-task-observer",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Pi Extension that passively observes session tasks and exposes /status.",
  "keywords": ["pi-package"],
  "license": "UNLICENSED",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "files": [
    "src",
    "README.md",
    "docs",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "package:smoke": "node --experimental-strip-types scripts/package-smoke.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
